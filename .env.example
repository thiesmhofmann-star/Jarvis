# Vorlage für .env.local – nur Namen, niemals Werte eintragen.
# Lokal: Datei nach .env.local kopieren und füllen. Produktion: Werte in Vercel eintragen.

# Neon Postgres (ab Anschluss-Block)
DATABASE_URL=

# Better Auth (ab Anschluss-Block; Namen laut Better-Auth-Doku)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google-Login (ab Anschluss-Block)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API (ab Anschluss-Block)
ANTHROPIC_API_KEY=

# Zugangsschutz: die einzige E-Mail-Adresse, die sich anmelden darf (ab Anschluss-Block)
ALLOWED_EMAIL=
