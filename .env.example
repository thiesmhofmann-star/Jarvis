# Vorlage für .env.local – nur Namen, niemals Werte eintragen.
# Lokal: Datei nach .env.local kopieren und füllen. Produktion: Werte in Vercel eintragen.

# Neon Postgres (ab Ticket 2)
DATABASE_URL=

# Better Auth (ab Ticket 2; Namen laut Better-Auth-Doku)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google-Login (ab Ticket 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API (ab Ticket 4)
ANTHROPIC_API_KEY=

# Zugangsschutz: die einzige E-Mail-Adresse, die sich anmelden darf (ab Ticket 2)
ALLOWED_EMAIL=
